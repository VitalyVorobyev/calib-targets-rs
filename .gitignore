target
.vscode
*.pyc
book/book
# Root-only: the local `build-site.sh` / CI Pages build output. Scoped with a
# leading slash so Vite source assets under `demo/public/` stay tracked.
/public/
tmpdata
synthetic
stereo
*.so
testdata/charuco_detect_config_test.json

# Benchmark / sweep artifacts — local-only, never commit.
# Contains per-frame JSONLs, aggregate JSONs, rendered overlays, etc.
bench_results/
# Stage-timing harness reports (topo / charuco / puzzleboard / full).
tools/out/
# calib-targets-bench overlay output for visual inspection of detector results.
preview/
# Local-only detection-performance reports + rendered overlays.
report/
# Private-dataset deep notes — concrete counts, frame IDs, failure
# breakdowns. Keep locally; public surfaces get general performance
# statements only (see CLAUDE.md disclosure policy).
docs/datasets/
# macOS Finder metadata.
.DS_Store
**/.DS_Store

# WASM build artifacts
crates/calib-targets-wasm/pkg/
demo/pkg/
demo/node_modules/
demo/dist/
uv.lock
REVIEW.md
API_REVISION.md

# Standalone research sub-projects under research/: source, tests and the
# write-up are tracked; run output, generated figures and venvs are not.
# The lock file is kept so a months-later resume reproduces the environment.
research/*/runs/
research/*/out/
research/*/.venv/
research/*/.pytest_cache/
!research/*/uv.lock
# The `report/` rule above is for local-only detector performance output; a
# research sub-project's write-up is a deliverable and is tracked.
!research/*/report/
!research/*/report/**
privatedata

# codegraph local index daemon (SQLite DB, socket, pid, logs)
.codegraph/

# calib-targets-studio local artifacts
studio/node_modules/
studio/dist/
studio_configs/
studio/tsconfig.tsbuildinfo
