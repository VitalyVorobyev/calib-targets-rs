{
  // The shared compiler options (strict, noUncheckedIndexedAccess, exactOptionalPropertyTypes,
  // verbatimModuleSyntax, bundler resolution) come from @vitavision/config-ts.
  "extends": "@vitavision/config-ts/tsconfig.json",
  "compilerOptions": {
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "eslint.config.js"]
}
