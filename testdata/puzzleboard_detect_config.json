{
  "image_path": "testdata/puzzleboard_small.png",
  "detector": {
    "chess": {
      "strategy": { "chess": { "ring": "canonical", "refiner": { "center_of_mass": { "radius": 2 } } } },
      "threshold": 15.0,
      "detection": { "nms_radius": 3, "min_cluster_size": 2 },
      "multiscale": "single_scale",
      "upscale": "disabled",
      "orientation_method": "ring_fit",
      "merge_radius": 3.0
    },
    "chessboard": {
      "min_labeled_corners": 8,
      "max_components": 3,
      "min_corner_strength": 33.0
    },
    "board": {
      "rows": 10,
      "cols": 10,
      "cell_size": 12.0,
      "origin_row": 0,
      "origin_col": 0
    },
    "decode": {
      "min_bit_confidence": 0.15,
      "max_bit_error_rate": 0.3,
      "search_all_components": true,
      "sample_radius_rel": 0.16666667
    }
  }
}
