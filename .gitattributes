# Normalise line endings so generated artefacts (schemas/) compare byte-for-byte.
# Keep this first: later rules (LFS `-text`) must override it.
* text=auto eol=lf

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
book/src/img/*.png filter=lfs diff=lfs merge=lfs -text
testdata/*.png filter=lfs diff=lfs merge=lfs -text
# Small published Pages previews: store inline (not LFS) so GitHub Pages
# serves real image bytes directly from the rsynced site tree. Binary: no
# LFS filter and no EOL normalization.
.github/pages/performance/img/*.png -filter -diff -merge -text
